# PengyShare Configuration
# Copy to .env and edit:  cp .env.example .env

# Public base URL (used in all generated links, for nginx/letsencrypt later)
BASE_URL=http://localhost:5001

# Directory where image files are stored (can point to NAS mount)
IMAGES_DIR=/home/beholder/PengyShare/images

# Max upload size in bytes (default: 512MB)
MAX_IMAGE_SIZE=536870912

# Allowed media extensions (images + videos, comma-separated)
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,bmp,tiff,svg,mov,mp4,m4v,webm,mkv

# Images shown on the index page
IMAGES_PER_PAGE=50

# API key for programmatic uploads (set to enable API)
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Comma-separated CIDRs allowed to upload/delete via web UI
# Default allows localhost only; set to your LAN range for network access
ALLOWED_POST_CIDR=127.0.0.1/32

# Flask debug mode
DEBUG=false

# Server bind address and port
HOST=0.0.0.0
PORT=5001
